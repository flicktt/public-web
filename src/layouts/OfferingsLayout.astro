---
import mem3Img from "../assets/mem-03.jpg";
import Faqs from "../components/faqs/Faqs.astro";
import Button from "../components/ui/inputs/Button.astro";
import type { ContainerProps, FaqConfig } from "../types";
import { cn } from "../utils";
import Container from "./Container.astro";

interface Props {
	title?: string;
	showMembership?: boolean;
	containerProps?: ContainerProps;
	faqConfig?: FaqConfig[];
  img?: { src: string, alt: string };
}

const mockConfig = [
	{
		title: "Proin placerat vitae nisl sed elementum?",
		Content:
			"Maecenas dignissim eros ut elit imperdiet convallis. Morbi bibendum erat in nisi fringilla egestas. Suspendisse convallis vulputate viverra. Curabitur blandit ornare porttitor. Nunc at mauris laoreet, mollis turpis sit amet, porttitor nunc. Curabitur rhoncus ipsum in ante finibus, non egestas diam sollicitudin. Aliquam erat volutpat. Nam sit amet consequat enim.",
	},
];

const {
	title,
  img,
	showMembership = true,
	faqConfig = mockConfig,
	containerProps,
} = Astro.props;

const containerClasses = cn(
	"pt-6 pb-14",
	containerProps?.class,
);
---

<Container main {...containerProps} class={containerClasses}>
  {title && <h2 class="font-bold text-center">{title}</h2>}
  <div class="flex flex-col gap-6 lg:gap-12">
    {img && (
      <div
        class="mt-6 w-full aspect-video lg:aspect-73/30 overflow-hidden border-8 border-flick-dark"
      >
        <img
          src={img.src}
          alt={img.alt}
          class="relative bottom-14 sm:bottom-25 lg:bottom-75 w-full object-cover aspect-4/3"
        />
      </div>
    )}
    <slot />
  </div>
</Container>

{showMembership && (
  <!-- TODO turn into reusable component along with home page section -->
  <div class="bg-membership">
    <Container class="flex flex-col lg:flex-row gap-8 py-12">
      <div>
        <div
          class="m-auto size-75 pb md:size-100 xl:size-125 rounded-4xl overflow-hidden border-10 border-black/10"
        >
          <img
            src={mem3Img.src}
            alt="Membership three"
            class="relative bottom-62.5 h-225 max-w-fit right-100"
          />
        </div>
      </div>
      <section
        class="flex flex-col text-center items-center justify-center gap-8 px-10 xl:pr-0 xl:text-right xl:items-end xl:gap-11"
      >
        <h3>Club Membership</h3>
        <p class="text-3xl">
          Members get big discounts on activities, including 1-2-1s, group
          sessions and club tables.
        </p>
        <Button>Find out more</Button>
      </section>
    </Container>
  </div>
)}

<Faqs faqConfig={faqConfig} />
