---
import { Image } from "astro:assets";
import mem3Img from "../assets/mem-03.jpg";
import Faqs from "../components/faqs/Faqs.astro";
import Button from "../components/ui/inputs/Button.astro";
import DisplayText from "../components/ui/text/DisplayText.astro";
import type { ContainerProps, FaqConfig } from "../types";
import { cn } from "../utils";
import Container from "./Container.astro";

interface Props {
  title?: string;
  showMembership?: boolean;
  containerProps?: ContainerProps;
  faqConfig: FaqConfig[];
  img?: { src: ImageMetadata; alt: string };
  desc?: string;
  linkBtn?: { label: string; href: string; external?: boolean };
}

const {
  title,
  img,
  desc,
  showMembership = true,
  faqConfig,
  containerProps,
  linkBtn,
} = Astro.props;

const containerClasses = cn("pt-6 pb-10 lg:pb-14", containerProps?.class);
---

<Container main {...containerProps} class={containerClasses}>
  {title && <h2 class="font-bold text-center">{title}</h2>}
  <div class="flex flex-col gap-8 lg:gap-10">
    {
      img && (
        <div class="mt-3 w-full aspect-video lg:aspect-73/30 overflow-hidden border-8 border-flick-dark">
          <Image
            src={img.src}
            alt={img.alt}
            width={1440}
            widths={[640, 1024, 1440, 2048]}
            sizes="(min-width: 1440px) 1440px, 100vw"
            class="relative bottom-14 sm:bottom-25 lg:bottom-75 w-full object-cover aspect-4/3"
            priority
          />
        </div>
      )
    }
    {
      desc && (
        <DisplayText class="text-xl sm:text-xl md:text-2xl">{desc}</DisplayText>
      )
    }
    {
      linkBtn && (
        <Button
          as="a"
          href={linkBtn.href}
          class="m-auto mb-2"
          size="lg"
          {...(linkBtn.external && {
            target: "_blank",
            rel: linkBtn.href.includes("bookwhen.com")
              ? "noopener nofollow"
              : "noopener",
          })}
        >
          {linkBtn.label}
        </Button>
      )
    }
    <slot />
  </div>
</Container>

{
  showMembership && (
    <div class="bg-flick-dark">
      {/* TODO turn into reusable component along with home page section */}
      <Container class="flex flex-col lg:flex-row gap-8 py-12">
        <div>
          <div class="m-auto size-75 pb md:size-100 xl:size-125 rounded-4xl overflow-hidden border-10 border-black/10">
            <Image
              src={mem3Img}
              alt="Membership three"
              height={900}
              class="relative bottom-62.5 h-225 max-w-fit right-100"
              loading="lazy"
            />
          </div>
        </div>
        <section class="flex flex-col text-center items-center justify-center gap-8 px-10 xl:pr-0 xl:text-right xl:items-end xl:gap-11">
          <hgroup>
            <h3>Club Membership</h3>
            <p class="text-3xl">
              Members get big discounts on activities, including 1-2-1s, group
              sessions and club tables.
            </p>
          </hgroup>
          <Button as="a" href="/membership/">
            Find out more
          </Button>
        </section>
      </Container>
    </div>
  )
}

<Faqs faqConfig={faqConfig} />
