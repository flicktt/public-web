---
import { bannerBg } from "../banner";
import { localBusinessSchema } from "../schema";
import Footer from "../components/footer/Footer.astro";
import HomeHeader from "../components/header/HomeHeader.astro";
import PageHeader from "../components/header/PageHeader.astro";
import "../styles/global.css";
import type { Page, PageConfig } from "../types";

interface Props {
  page: Page;
}

const pageConfig: Record<Page, PageConfig> = {
  // TODO descriptions need filling out for each page
  home: {
    title: "Home",
    desc: "",
    heading: "", // the home page renders its own <h1> in src/pages/index.astro
  },
  offerings: {
    title: "Offerings",
    desc: "",
    heading: "Table tennis coaching, group sessions, open play and table hire in London",
  },
  compete: {
    title: "Compete",
    desc: "",
    heading: "Table tennis league and tournaments at Flick TT, London",
  },
  kids: {
    title: "Kids",
    desc: "",
    heading: "Table tennis coaching for children and schools in London",
  },
  membership: {
    title: "Membership",
    desc: "",
    heading: "Flick TT table tennis club membership, London",
  },
  about: {
    title: "About",
    desc: "",
    heading: "Flick TT, the table tennis club at Decathlon Surrey Quays, Canada Water",
  },
  coaches: {
    title: "Coaches",
    desc: "",
    heading: "The table tennis coaches at Flick TT, London",
  },
};

const { page } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en" class="font-briolage-grot bg-flick-black text-white">
  <head>
    <meta charset="utf-8" />
    <link rel="canonical" href={canonical.href} />
    <link
      rel="preload"
      href="/fonts/bricolage-grotesque-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" as="image" href={bannerBg.src} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageConfig[page].desc} />
    <title>{`Flick TT | ${pageConfig[page].title}`}</title>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(localBusinessSchema)}
    />
  </head>
  <body>
    {
      page === "home" ? (
        <HomeHeader />
      ) : (
        <PageHeader
          title={pageConfig[page].title}
          heading={pageConfig[page].heading}
        />
      )
    }
    <slot />
    <Footer />
  </body>
</html>
