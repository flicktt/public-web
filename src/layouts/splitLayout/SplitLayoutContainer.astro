---
import { cn } from "../../utils";

interface Props extends astroHTML.JSX.HTMLAttributes {
	section?: boolean;
}

const { section, ...props } = Astro.props;

const classes = cn("grid grid-cols-1 lg:grid-cols-3 gap-8", props?.class);
---

{
  section ? (
    <section class={classes} {...props}>
      <slot />
    </section>
  ) : (
    <div class={classes} {...props}>
      <slot />
    </div>
  )
}
