---
interface Props {
  titleAs?: "h2" | "h3";
  title?: string;
  subtitle?: string;
}

const { title, titleAs: TitleTag = "h3", subtitle } = Astro.props;
---

<div class="col-span-1">
  {
    title && (
      <TitleTag class:list={["text-4xl", { "mb-2": !!subtitle }]}>
        {title}
      </TitleTag>
    )
  }
  {subtitle && <p class="text-xl">{subtitle}</p>}
  <slot />
</div>
