---
import type { ContainerProps } from "../types";
import { cn } from "../utils";

interface Props extends ContainerProps {}

const { section, main, fullMaxWidth, ...props } = Astro.props;

const classes = cn(
  "m-auto w-full px-6 lg:px-12",
  fullMaxWidth ? "max-w-full" : "max-w-section",
  props?.class,
);
---

{
  section ? (
    <section class={classes} {...props}>
      <slot />
    </section>
  ) : main ? (
    <main class={classes} {...props}>
      <slot />
    </main>
  ) : (
    <div class={classes} {...props}>
      <slot />
    </div>
  )
}
