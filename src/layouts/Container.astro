---
import { cn } from "../utils";

interface Props extends astroHTML.JSX.HTMLAttributes {
	section?: boolean;
	main?: boolean;
}

const { section, main, ...props } = Astro.props;

const classes = cn(
	"m-auto w-full px-6 lg:px-12 max-w-section",
	props?.class ?? "",
);
---

{
  section ? (
    <section class={classes} {...props}>
      <slot />
    </section>
  ) : main ? (
    <main class={classes} {...props}>
      <slot />
    </main>
  ) : (
    <div class={classes} {...props}>
      <slot />
    </div>
  )
}
