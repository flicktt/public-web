---
import Faqs from "../../components/faqs/Faqs.astro";
import PhotoGallery from "../../components/membership/PhotoGallery.astro";
import PricingCard from "../../components/membership/PricingCard.astro";
import PricingTable from "../../components/membership/PricingTable.astro";
import PointsRow from "../../components/pointsRow/PointsRow.astro";
import Button from "../../components/ui/inputs/Button.astro";
import DisplayText from "../../components/ui/text/DisplayText.astro";
import FaceSmile from "../../icons/FaceSmile.svg";
import PercentBadge from "../../icons/PercentBadge.svg";
import Container from "../../layouts/Container.astro";
import PageLayout from "../../layouts/PageLayout.astro";
import SplitLayoutContainer from "../../layouts/splitLayout/SplitLayoutContainer.astro";
import SplitLayoutLeft from "../../layouts/splitLayout/SplitLayoutLeft.astro";
import SplitLayoutRight from "../../layouts/splitLayout/SplitLayoutRight.astro";

const pointConfig = [
  {
    Icon: PercentBadge,
    text: "Members get big discounts on all activities, as well as access to free Masterclass sessions, held every two months ",
  },
  {
    Icon: FaceSmile,
    text: "Become part of a huge friendly and passionate table tennis community, dedicated to spreading the love for the sport throughout London",
  },
];

const faqConfig = [
  {
    title: "Proin placerat vitae nisl sed elementum?",
    Content:
      "Maecenas dignissim eros ut elit imperdiet convallis. Morbi bibendum erat in nisi fringilla egestas. Suspendisse convallis vulputate viverra. Curabitur blandit ornare porttitor. Nunc at mauris laoreet, mollis turpis sit amet, porttitor nunc. Curabitur rhoncus ipsum in ante finibus, non egestas diam sollicitudin. Aliquam erat volutpat. Nam sit amet consequat enim.",
  },
  {
    title: "In venenatis tortor leo, et vulputate mauris interdum in?",
    Content:
      "Maecenas dignissim eros ut elit imperdiet convallis. Morbi bibendum erat in nisi fringilla egestas. Suspendisse convallis vulputate viverra. Curabitur blandit ornare porttitor. Nunc at mauris laoreet, mollis turpis sit amet, porttitor nunc. Curabitur rhoncus ipsum in ante finibus, non egestas diam sollicitudin. Aliquam erat volutpat. Nam sit amet consequat enim.",
  },
  {
    title:
      "Vestibulum dignissim tempus justo, auctor vulputate urna varius dignissim?",
    Content:
      "Maecenas dignissim eros ut elit imperdiet convallis. Morbi bibendum erat in nisi fringilla egestas. Suspendisse convallis vulputate viverra. Curabitur blandit ornare porttitor. Nunc at mauris laoreet, mollis turpis sit amet, porttitor nunc. Curabitur rhoncus ipsum in ante finibus, non egestas diam sollicitudin. Aliquam erat volutpat. Nam sit amet consequat enim.",
  },
];

const pricingRows = [
  { offering: "Group session", normal: "£20", member: "£12" },
  { offering: "Open session", normal: "£10", member: "£5" },
  { offering: "Private Coaching lesson", normal: "£60", member: "£45" },
  { offering: "Workshop", normal: "N/A", member: "Free" },
  {
    offering: "Flick TT League season membership",
    normal: "£65",
    member: "£35",
  },
  { offering: "Flick TT Tournament entry", normal: "£25", member: "£15" },
  { offering: "Club Table", normal: "£5.50 / £9.50", member: "£2 / £3" },
];

const pricingConfig = {
  normal: pricingRows.map(({ offering, normal }) => ({
    label: offering,
    price: normal,
  })),
  members: pricingRows.map(({ offering, member }) => ({
    label: offering,
    price: member,
  })),
};
---

<PageLayout page="membership">
  <Container class="flex flex-col gap-10 lg:gap-14 py-10 lg:py-14">
    <DisplayText class="text-center">
      Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut quis ipsum et
      neque viverra pulvinar sit amet quis sem. Orci varius natoque penatibus et
      magnis dis parturient montes, nascetur ridiculus mus. Etiam sit amet urna
      viverra, laoreet dolor nec, elementum nisi. Morbi dapibus et justo a
      facilisis.
    </DisplayText>
    <Button
      as="a"
      size="lg"
      href="https://bookwhen.com/flicktt/memberships"
      target="_blank"
      class="m-auto"
    >
      Become a member
    </Button>
  </Container>
  <PointsRow pointConfig={pointConfig} />
  <div class="border-b border-flick-dark">
    <PhotoGallery />
  </div>
  <Container class="lg:gap-14 py-10 lg:py-14">
    <SplitLayoutContainer>
      <SplitLayoutLeft title="Membership benefits" />
      <SplitLayoutRight>
        <div class="flex flex-col gap-8">
          <div class="hidden sm:block">
            <PricingTable rows={pricingRows} />
          </div>
          <div class="sm:hidden">
            <PricingCard
              title="Normal"
              prices={pricingConfig.normal}
              bg="dark"
            />
            <PricingCard
              title="Members"
              prices={pricingConfig.members}
              bg="yellow"
            />
          </div>
        </div>
      </SplitLayoutRight>
    </SplitLayoutContainer>
  </Container>
  <Faqs faqConfig={faqConfig} />
</PageLayout>
