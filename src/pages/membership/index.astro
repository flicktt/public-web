---
import Faqs from "../../components/faqs/Faqs.astro";
import MembershipBenefits from "../../components/membership/MembershipBenefits.astro";
import MembershipTypes from "../../components/membership/MembershipTypes.astro";
import PhotoGallery from "../../components/membership/PhotoGallery.astro";
import PointsRow from "../../components/pointsRow/PointsRow.astro";
import Button from "../../components/ui/inputs/Button.astro";
import DisplayText from "../../components/ui/text/DisplayText.astro";
import FaceSmile from "../../icons/FaceSmile.svg";
import PercentBadge from "../../icons/PercentBadge.svg";
import Container from "../../layouts/Container.astro";
import PageLayout from "../../layouts/PageLayout.astro";
import type { FaqConfig } from "../../types";

const pointConfig = [
  {
    Icon: PercentBadge,
    text: "Members get big discounts on all activities, as well as access to free Workshop sessions, held every two months ",
  },
  {
    Icon: FaceSmile,
    text: "Become part of a huge friendly and passionate table tennis community, dedicated to spreading the love for the sport throughout London",
  },
];

const faqConfig: FaqConfig[] = [
  {
    title: "How do I join?",
    Content: "You can join our membership at bookwhen.com/flicktt/memberships.",
  },
  {
    title: "How long does membership last, and can I cancel?",
    Content:
      "Our memberships are available in monthly, quarterly, biannual and annual periods. You can cancel your membership directly through Bookwhen. Your membership will continue to run until the end of your renewal period.",
  },
  {
    title: "How do I switch membership type or subscription period?",
    Content:
      "Please contact us through email or WhatsApp and we can sort it out for you.",
  },
];
---

<PageLayout page="membership">
  <Container class="flex flex-col gap-10 lg:gap-14 py-10 lg:py-14">
    <DisplayText class="text-center">
      Membership is a great way to save money for table tennis enthusiasts who
      join our sessions regularly. You get reduced rates on all activities at
      the club, free entry to our workshops, and{" "}
      <span class="text-flick-yellow">
        a place in one of London's{" "}
        <b>friendliest table tennis communities.</b>
      </span>
    </DisplayText>
    <!-- mb-2 on Button to match line height spacing on DisplayText -->
    <Button
      as="a"
      size="lg"
      href="https://bookwhen.com/flicktt/memberships"
      target="_blank"
      class="m-auto mb-2"
    >
      Become a member
    </Button>
  </Container>
  <PointsRow pointConfig={pointConfig} />
  <div class="border-b border-flick-dark">
    <PhotoGallery />
  </div>
  <Container class="flex flex-col gap-10 lg:gap-14 pt-10 pb-14 lg:pt-14">
    <MembershipTypes />
    <MembershipBenefits />
  </Container>
  <Faqs headerAs="h2" faqConfig={faqConfig} />
</PageLayout>
