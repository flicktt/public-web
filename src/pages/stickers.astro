---
import Sticker from "../components/treasureHunt/Sticker.astro";
import DisplayText from "../components/ui/text/DisplayText.astro";
import Container from "../layouts/Container.astro";
import PageLayout from "../layouts/PageLayout.astro";

// Treasure hunt decoy for anyone who guesses /stickers/ hoping for a gallery. Not linked from
// anywhere. Passed to PageLayout as a hidden page: noindex/nofollow, no canonical, and not part of
// the page registry; astro.config.mjs keeps it out of the sitemap.
---

<PageLayout
  hidden={{
    title: "Stickers",
    metaTitle: "Stickers | Flick TT",
    desc: "Nice try.",
    heading: "Stickers",
  }}
>
  <Container main class="flex flex-col items-center gap-6 py-10 lg:py-14">
    <Sticker id="mark-stickers-page" size={192} />
    <DisplayText class="text-center text-5xl sm:text-6xl font-bold">Seriously?</DisplayText>
    <DisplayText class="text-center">
      Did you really think we would put all the stickers into a single page?
    </DisplayText>
  </Container>
</PageLayout>
