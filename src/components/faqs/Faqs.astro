---
import Container from "../../layouts/Container.astro";
import type { FaqConfig } from "../../types";
import Accordion from "../accordion/Accordion.astro";
import AccordionContent from "../accordion/AccordionContent.astro";
import AccordionStack from "../accordion/AccordionStack.astro";
import AccordionTitle from "../accordion/AccordionTitle.astro";

interface Props {
  headerAs?: "h2" | "h3";
  faqConfig: FaqConfig[];
}

const { headerAs: HeaderTag = "h3", faqConfig } = Astro.props;

// FAQPage structured data (schema.org). Google no longer shows FAQ rich results for sites like
// ours, but the markup is still read by AI answer engines and non-Google search.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqConfig.flatMap(({ title, Content, answerText }) => {
    const text = typeof Content === "string" ? Content : answerText;
    if (!text) {
      console.warn(
        `[Faqs] "${title}" has a component answer but no answerText; omitted from JSON-LD`,
      );
      return [];
    }
    return [
      {
        "@type": "Question",
        name: title,
        acceptedAnswer: { "@type": "Answer", text },
      },
    ];
  }),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<div class="bg-flick-red">
  <Container section class="pt-10 pb-10 lg:pb-14 text-xl">
    <HeaderTag class="text-flick-yellow mb-6 text-5xl sm:text-6xl">
      Frequently Asked Questions
    </HeaderTag>
    <AccordionStack>
      {
        (faqConfig as FaqConfig[]).map(({ title, Content }, i) => {
          const titleId = `faq-${i}-btn`;
          const panelId = `faq-${i}-panel`;

          return (
            <Accordion>
              <AccordionTitle
                headerAs={HeaderTag === "h2" ? "h3" : "h4"}
                id={titleId}
                ariaControls={panelId}
              >
                {title}
              </AccordionTitle>
              <AccordionContent id={panelId} ariaLabelledBy={titleId}>
                {typeof Content === "string" ? <p>{Content}</p> : <Content />}
              </AccordionContent>
            </Accordion>
          );
        })
      }
    </AccordionStack>
  </Container>
</div>
