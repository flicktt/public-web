---
import { Image } from "astro:assets";
import { COACH_TITLES } from "../../constants";
import type { CoachProfileConfig } from "../../types";
import Drawer from "../ui/drawer/Drawer.astro";
import Sticker from "../treasureHunt/Sticker.astro";

interface Props {
  profile: CoachProfileConfig;
}

const { profile } = Astro.props;
const { name, img, description, title, sticker } = profile;
---

<Drawer id={`${name.split(" ").join("-")}-drawer`}>
  {sticker && <Sticker id={sticker} class="absolute top-2 left-2" />}
  <div class="flex flex-col gap-2 justify-end p-6 text-left">
    <Image src={img} width={340} densities={[1, 2]} alt={name} loading="lazy" />
    <div>
      <p class="text-3xl"><b>{name}</b></p>
      <p class="text-2xl font-light text-flick-yellow">
        {COACH_TITLES[title].singular}
      </p>
    </div>
    {
      description.map((desc, i) => (
        <p class={i === 0 ? "text-lg font-semibold" : ""}>{desc}</p>
      ))
    }
  </div>
</Drawer>
