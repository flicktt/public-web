---
import { getImage } from "astro:assets";
import { STICKERS, stickerRenderWidth, type StickerId } from "../../treasureHunt";

/**
 * Places one treasure hunt sticker out of several, chosen at random on every page load.
 * Pages are prerendered, so the server can't choose: it emits the optimised URL for every
 * candidate and a tiny inline script picks one before first paint. The chosen sticker gets the
 * same `data-sticker` marker as a `<Sticker />`.
 */
interface Props {
  ids: readonly StickerId[];
  /** Rendered width/height in CSS px (source stickers are 512×512). */
  size?: number;
}

const { ids, size = 48 } = Astro.props;

const candidates = await Promise.all(
  ids.map(async (id) => {
    const { img } = STICKERS[id];
    // Generated larger than displayed so the sticker stays sharp when the reader zooms in.
    const renderWidth = stickerRenderWidth(size);
    const image = await getImage({ src: img, width: renderWidth, height: renderWidth });
    return { id, src: image.src };
  }),
);
const domId = `random-sticker-${Math.random().toString(36).slice(2, 8)}`;
---

{/* No src server-side, so the preload scanner doesn't fetch a sticker the script then replaces. */}
<img
  id={domId}
  width={size}
  height={size}
  alt=""
  class="select-none"
  data-candidates={JSON.stringify(candidates)}
/>
<script is:inline define:vars={{ domId }}>
  const img = document.getElementById(domId);
  const options = JSON.parse(img.dataset.candidates);
  const pick = options[Math.floor(Math.random() * options.length)];
  img.src = pick.src;
  img.dataset.sticker = pick.id;
  delete img.dataset.candidates;
</script>
