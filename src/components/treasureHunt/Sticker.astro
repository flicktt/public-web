---
import { getImage } from "astro:assets";
import { STICKERS, stickerRenderWidth, type StickerId } from "../../treasureHunt";

interface Props extends astroHTML.JSX.HTMLAttributes {
  id: StickerId;
  /** Rendered width in CSS px (source stickers are 512×512). */
  size?: number;
}

const { id, size = 48, class: className, ...rest } = Astro.props;
const { img } = STICKERS[id];
// Generated larger than displayed so the sticker stays sharp when the reader zooms in.
const renderWidth = stickerRenderWidth(size);
const image = await getImage({ src: img, width: renderWidth, height: renderWidth });
---

<img
  src={image.src}
  alt=""
  width={size}
  height={size}
  loading="lazy"
  decoding="async"
  data-sticker={id}
  class:list={["select-none", className]}
  {...rest}
/>
