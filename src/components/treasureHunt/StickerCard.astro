---
import type { StickerId } from "../../treasureHunt";
import XMark from "../../icons/XMark.svg";
import Sticker from "./Sticker.astro";

/**
 * The notification card used by the pop-up stickers: sticker on the left, message, and an
 * optional dismiss button. Fixed at the bottom of the screen, hidden until `data-shown` is set.
 * Behaviour (when to show, what dismissing does) belongs to the component that uses it, which
 * hooks in via the `data-card-message` and `data-card-dismiss` elements.
 */
interface Props extends astroHTML.JSX.HTMLAttributes {
  id: StickerId;
  message?: string;
  dismissible?: boolean;
}

const { id, message = "", dismissible = false, class: className, ...rest } = Astro.props;
---

<div
  class:list={[
    "fixed inset-x-4 bottom-4 z-50 mx-auto flex max-w-md items-center gap-4 rounded-xl border border-flick-yellow bg-flick-black p-4 text-white shadow-[0_0_40px_0_rgba(0,0,0,0.6)] transition-[opacity,translate] duration-500 not-data-shown:pointer-events-none not-data-shown:opacity-0 not-data-shown:translate-y-4 motion-reduce:transition-none",
    className,
  ]}
  role="status"
  {...rest}
>
  <Sticker id={id} size={96} class="shrink-0" />
  <p class="text-lg font-semibold" data-card-message>{message}</p>
  {
    dismissible && (
      <button
        type="button"
        class="shrink-0 cursor-pointer self-start rounded-md p-1 hover:bg-white/10"
        aria-label="Dismiss"
        data-card-dismiss
      >
        <XMark class="size-6" />
      </button>
    )
  }
</div>
