---
import type { StickerId } from "../../treasureHunt";
import type { Page } from "../../types";
import StickerCard from "./StickerCard.astro";

/**
 * Rewards a reader who has visited every page of the site with a sticker in a pop-up. Visited
 * pages are remembered in localStorage; once the set is complete the pop-up appears on every
 * page until the reader dismisses it. Dismissing resets the visited set (to just the current
 * page), so doing the full round again earns the pop-up again.
 */
interface Props {
  id: StickerId;
  message: string;
  /** Id of the page being rendered; omit on hidden pages, which then don't count. */
  page?: Page;
  /** Every page that counts towards the reward. */
  pages: readonly Page[];
}

const { id, message, page, pages } = Astro.props;
---

<StickerCard
  id={id}
  message={message}
  dismissible
  data-visited-all
  data-page={page}
  data-pages={JSON.stringify(pages)}
/>

<script>
  const el = document.querySelector<HTMLElement>("[data-visited-all]");
  const VISITED_KEY = "hunt:visited-pages";

  if (el) {
    try {
      const page = el.dataset.page;
      const pages: string[] = JSON.parse(el.dataset.pages ?? "[]");
      const visited = new Set<string>(JSON.parse(localStorage.getItem(VISITED_KEY) ?? "[]"));
      if (page) visited.add(page);
      localStorage.setItem(VISITED_KEY, JSON.stringify([...visited]));

      if (pages.every((p) => visited.has(p))) {
        // Let the initial (hidden) style apply first so the entrance transition plays.
        setTimeout(() => el.setAttribute("data-shown", ""), 50);
        el.querySelector("[data-card-dismiss]")?.addEventListener("click", () => {
          el.removeAttribute("data-shown");
          // Start the round again; the page they're on counts as seen.
          localStorage.setItem(VISITED_KEY, JSON.stringify(page ? [page] : []));
        });
      }
    } catch {
      // localStorage unavailable (private mode etc.): no reward tracking, nothing to show.
    }
  }
</script>
