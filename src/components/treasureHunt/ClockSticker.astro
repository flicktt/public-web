---
import type { StickerId } from "../../treasureHunt";
import StickerCard from "./StickerCard.astro";

/**
 * A dismissible sticker card for readers who load a page at a particular time of day (local
 * time). Two modes:
 *
 * - `at`: an exact minute on a 12-hour clock, matching both am and pm (e.g. 12:25). Dismissing
 *   hides it for that occurrence (that date, am or pm); it comes back at the next one.
 * - `between`: a window of 24-hour hours, `from` inclusive to `to` exclusive (e.g. 2 to 6 for
 *   2:00–5:59 am). Dismissing hides it for the rest of that day.
 *
 * `message` may contain `{time}`, replaced with the current time, e.g. "12:25 pm" or "2:00am"
 * depending on `timeFormat`.
 */
interface Props {
  id: StickerId;
  message: string;
  at?: { hour12: number; minute: number };
  between?: { from: number; to: number };
  timeFormat?: "spaced" | "compact";
}

const { id, message, at, between, timeFormat = "spaced" } = Astro.props;
if (!at && !between) throw new Error("ClockSticker needs `at` or `between`");
---

<StickerCard
  id={id}
  dismissible
  data-clock-sticker
  data-at={at && JSON.stringify(at)}
  data-between={between && JSON.stringify(between)}
  data-time-format={timeFormat}
  data-message={message}
/>

<script>
  for (const el of document.querySelectorAll<HTMLElement>("[data-clock-sticker]")) {
    const now = new Date();
    const hour24 = now.getHours();
    const hour12 = hour24 % 12 || 12;
    const minute = now.getMinutes();
    const ampm = hour24 < 12 ? "am" : "pm";

    let matches = false;
    let occurrence = now.toDateString();
    if (el.dataset.at) {
      const at = JSON.parse(el.dataset.at);
      matches = hour12 === at.hour12 && minute === at.minute;
      occurrence += ` ${ampm}`;
    } else if (el.dataset.between) {
      const { from, to } = JSON.parse(el.dataset.between);
      matches = hour24 >= from && hour24 < to;
    }
    if (!matches) continue;

    // One dismissal key per card and occurrence, so dismissing only covers that one.
    const dismissedKey = `hunt:clock-dismissed:${el.dataset.at ?? el.dataset.between}`;
    let dismissed = false;
    try {
      dismissed = localStorage.getItem(dismissedKey) === occurrence;
    } catch {}
    if (dismissed) continue;

    const time = `${hour12}:${String(minute).padStart(2, "0")}${el.dataset.timeFormat === "compact" ? "" : " "}${ampm}`;
    el.querySelector("[data-card-message]")!.textContent = (el.dataset.message ?? "").replace(
      "{time}",
      time,
    );
    // Let the initial (hidden) style apply first so the entrance transition plays.
    setTimeout(() => el.setAttribute("data-shown", ""), 50);
    el.querySelector("[data-card-dismiss]")?.addEventListener("click", () => {
      el.removeAttribute("data-shown");
      try {
        localStorage.setItem(dismissedKey, occurrence);
      } catch {}
    });
  }
</script>
