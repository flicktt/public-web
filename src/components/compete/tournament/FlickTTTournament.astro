---
import InfoHighlightLayout from "../../../layouts/InfoHighlightLayout.astro";
import OfferingsLayout from "../../../layouts/OfferingsLayout.astro";
import type { FaqConfig } from "../../../types";
import Button from "../../ui/inputs/Button.astro";
import RankingPoints from "./RankingPoints.astro";
import TournamentFormat from "./TournamentFormat.astro";

const faqConfig: FaqConfig[] = [
  {
    title: "Who can enter the tournament?",
    Content:
      "Everyone is welcome, you do not need to be a member or a league player. With a group stage followed by main and consolation draws, you are guaranteed plenty of matches no matter your level.",
  },
  {
    title: "How does the day work?",
    Content:
      "48 players start in groups, then progress into the main draw or the consolation draw, so nobody is knocked out after one match. The day runs from 9:30am to 5pm.",
  },
  {
    title: "What does it cost and what can I win?",
    Content:
      "Entry is £12 for members and £25 for non-members. The winner gets £125, the runner-up gets £75, and third place gets £50. There are also prizes for winners of the consolation draw.",
  },
  {
    title: "Do I need to play all 5 tournaments to be ranked?",
    Content:
      "No — there's no minimum number of tournaments required to appear in the Flick TT Ranking. Every tournament you play contributes points toward your season total, so you can join as many or as few as you like. That said, since all five tournaments count toward your final ranking, playing more gives you more chances to rack up points and improve your standing.",
  },
  {
    title: "How are groups decided?",
    Content:
      "To keep the group stage fair and competitive, the 8 highest-ranked players in the Flick TT Ranking are seeded, with one seeded player placed into each group. The remaining players are then allocated based on a combination of Flick TT Ranking, TTE ranking, and playing level as assessed by Flick TT, with the draw conducted randomly within those criteria. The goal is to avoid groups that are overly strong or weak, so every player gets a fair and competitive tournament. Final group composition is determined by the Flick TT tournament organisers, whose decision is final.",
  },
  {
    title: "What if I don't make the final?",
    Content:
      "The competition doesn't stop when your last match ends! All players who stay at the venue until the end of the tournament are entered into a prize draw, with prizes including table tennis rubbers, Flick TT kit, vouchers, and other rewards.",
  },
  {
    title: "Do I need to bring my own racket?",
    Content: "Yes, you will need your own racket for a Flick TT tournament.",
  },
];
---

<OfferingsLayout
  title="Flick TT Tournament"
  showMembership={false}
  containerProps={{ class: "gap-8" }}
  faqConfig={faqConfig}
>
  <p class="text-3xl md:text-4xl text-flick-yellow text-center">
    Compete in five open Ranking Tournaments throughout the season for a shot at
    the <b>Top 32 Finals</b>.
  </p>
  <p class="font-light text-xl lg:text-2xl text-center">
    Each tournament features 48 players in a group stage followed by knockout
    Main and Consolation Draws, guaranteeing at least 6 matches per player.
    Points earned across all five tournaments determine your Flick TT Ranking,
    and the season's top 32 players qualify for the Finals to decide the Flick
    TT Champion of the Year.
  </p>
  <Button
    as="a"
    size="lg"
    class="m-auto"
    href="https://bookwhen.com/flicktt-competitions"
    target="_blank"
    rel="noopener nofollow"
  >
    Register Now
  </Button>
  <InfoHighlightLayout title="Next Tournament" size="md">
    <div class="flex flex-row gap-1 items-end">
      <h4 class="font-bold text-2xl">14 June 2026</h4>
      <p>9:30am - 5pm</p>
    </div>
    <p>48 players</p>
    <p>Group stage, then main & consolation draw</p>
    <p>
      <b>Fee:</b>{" "}
      £12 (Members) / £25 (Non-Members)
    </p>
    <p>
      <b>Prizes:</b>{" "}
      Winner: £125, Runner Up: £75, 3rd Place: £50, plus consolation prizes
    </p>
  </InfoHighlightLayout>
  <TournamentFormat />
  <RankingPoints />
</OfferingsLayout>
