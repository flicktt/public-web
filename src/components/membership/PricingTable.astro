---
import type { StickerId } from "../../treasureHunt";
import RevealSticker from "../treasureHunt/RevealSticker.astro";

export interface PricingRow {
  offering: string;
  normal: string;
  member: string;
  /** Treasure hunt sticker revealed by hovering/clicking the member price. */
  memberSticker?: StickerId;
}

interface Props {
  rows: PricingRow[];
}

const { rows } = Astro.props;
---

<table
  class="table-auto w-full border border-flick-dark rounded-xl border-separate border-spacing-0"
>
  <thead class="text-3xl">
    <tr>
      <th class="p-4 border-b border-flick-dark text-left">Offering</th>
      <th class="p-4 border-b border-l bg-white/2 border-flick-dark">Normal</th>
      <th
        class="p-4 border-b border-l border-black/10 bg-flick-yellow text-flick-black rounded-tr-xl"
      >
        Members
      </th>
    </tr>
  </thead>
  <tbody class="text-2xl">
    {
      rows.map(({ offering, normal, member, memberSticker }, i) => (
        <tr class="group">
          <td
            class:list={[
              "m-0 p-4 group-hover:bg-white/2",
              { "border-b border-flick-dark": i !== rows.length - 1 },
            ]}
          >
            <b>{offering}</b>
          </td>
          <td
            class:list={[
              "m-0 p-4 text-center border-l bg-white/2 group-hover:bg-white/4 border-flick-dark",
              { "border-b": i !== rows.length - 1 },
            ]}
          >
            {normal}
          </td>
          <td
            class:list={[
              "m-0 p-4 text-center border-l border-black/10 bg-flick-yellow group-hover:bg-flick-yellow/96 text-flick-black",
              { "border-b": i !== rows.length - 1 },
              { "rounded-br-xl": i === rows.length - 1 },
            ]}
          >
            {memberSticker ? (
              <RevealSticker id={memberSticker}>{member}</RevealSticker>
            ) : (
              member
            )}
          </td>
        </tr>
      ))
    }
  </tbody>
</table>
