---
import { Image } from "astro:assets";

const photos: { src: ImageMetadata; alt: string }[] = [];
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/membership-gallery-*.png",
);
for await (const imgPromise of Object.values(images)) {
  const img = await imgPromise();
  photos.push({ src: img.default, alt: "" });
}
const photosSplit = [
  ...[...Array(3)].map((_, index) => photos.slice(index * 3, (index + 1) * 3)),
];
---

<div
  class="flex max-w-section m-auto px-6 lg:px-12 justify-center gap-6 mask-y-from-80%"
>
  <!-- desktop -->
  {
    photosSplit.map((photos, splitIndex) => (
      <div class="hidden sm:flex max-h-250 flex-col overflow-hidden select-none gap-6 hover:*:animation-state-paused">
        {[...Array(2)].map((_, uiIndex) => (
          <ul
            class:list={[
              `flex flex-col shrink-0 justify-around min-w-full gap-6 animate-marquee-vertical`,
              {
                "animation-direction-reverse": splitIndex % 2,
              },
            ]}
            aria-hidden={uiIndex === 1}
          >
            {photos.map(({ src, alt }) => (
              <Image src={src} alt={alt} class="rounded-xl" loading="lazy" />
            ))}
          </ul>
        ))}
      </div>
    ))
  }
  <!-- mobile -->
  {
    (
      <div class="flex sm:hidden max-h-200 flex-col overflow-hidden select-none gap-6 hover:*:animation-state-paused">
        {[...Array(2)].map((_, ulIndex) => (
          <ul
            class:list={[
              "flex flex-col shrink-0 justify-around min-w-full gap-6 animate-marquee-vertical animation-duration-[200s]",
            ]}
            aria-hidden={ulIndex === 1}
          >
            {photos.map(({ src, alt }) => (
              <Image src={src} alt={alt} class="rounded-xl" loading="lazy" />
            ))}
          </ul>
        ))}
      </div>
    )
  }
</div>
