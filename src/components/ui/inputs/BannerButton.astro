---
import type { Polymorphic } from "astro/types";

type Props<Tag extends "a" | "button"> = Polymorphic<{ as: Tag }>;

const { as: Tag = "button", ...props } = Astro.props;
---

<Tag
  class="w-69 py-1 text-center text-white bg-white/35 rounded text-3xl font-semibold cursor-pointer transition duration-150 hover:bg-white/50"
  {...props}
>
  <slot />
</Tag>
