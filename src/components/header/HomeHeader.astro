---
import BannerLogo from "../../assets/logo-no-sub.svg";
import HeaderLayout from "../../layouts/HeaderLayout.astro";
import BannerButton from "../ui/inputs/BannerButton.astro";
import WithSmoothScrollTo from "../ui/with/WithSmoothScrollTo.astro";
---

<HeaderLayout page="home">
  <div
    class="flex flex-col gap-10 items-center justify-between lg:flex-row xl:gap-30"
  >
    <WithSmoothScrollTo originId="banner-btn-schedule" toId="schedule">
      <BannerButton id="banner-btn-schedule"> Schedule </BannerButton>
    </WithSmoothScrollTo>
    <BannerButton as="a" href="/membership">Membership</BannerButton>
    <BannerButton as="a" href="https://bookwhen.com/flicktt" target="_blank">
      Book
    </BannerButton>
  </div>
  <div class="max-w-375 w-full">
    <BannerLogo />
  </div>
</HeaderLayout>
