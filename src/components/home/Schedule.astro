---
import type { ScheduleDayProps } from "../../types";
import ScheduleDay from "./ScheduleDay.astro";

interface Props {
  config: ScheduleDayProps[];
}

const { config } = Astro.props;

const openHours = ["09:00", "12:00", "15:00", "18:00"];
---

<div class="py-4" id="schedule">
  <div class="p-10 text-center rounded-xl border-flick-yellow border">
    <h3 class="font-light text-6xl text-flick-yellow">Schedule</h3>
    <div class="flex flex-row mt-10">
      <div class="min-w-16 lg:min-w-20">
        <div class="h-11"></div>
        <div class="h-190 grid grid-rows-22 gap-2">
          {
            openHours.map((hour, index) => (
              <div
                class:list={[
                  "border-t-3 border-white/10 border-dotted pt-4 text-xl",
                  index === openHours.length - 1 ? "row-span-4" : "row-span-6",
                ]}
              >
                {hour}
              </div>
            ))
          }
        </div>
      </div>
      <div
        class="overflow-x-scroll overflow-y-visible xl:overflow-x-visible pb-1"
      >
        <div class="w-315 xl:w-full grid grid-cols-7 gap-x-3">
          {
            config.map(({ blocks, day }) => (
              <ScheduleDay day={day} blocks={blocks} />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</div>
