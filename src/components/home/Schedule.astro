const openHours = ["09:00", "12:00", "15:00", "18:00"];
---

<div class="pt-4" id="schedule">
  <div class="p-10 text-center rounded-xl border-flick-yellow border">
    <h3 class="font-light text-6xl text-flick-yellow">Schedule</h3>
    <div class="group flex flex-row mt-10">
      <div
        id="schedule-hours-col"
        class="min-w-20 transition-shadow not-xl:not-data-[scroll=0]:shadow-[0_0_75px_0_rgba(0,0,0,0.33)] [clip-path:inset(0_-75px_0_0)]"
        data-scroll="0"
      >
        <div class="h-11" role="presentation"></div>
        <div class="h-190 grid grid-rows-22 gap-2">
          {
            openHours.map((hour, i) => (
              <div
                class:list={[
                  "border-t-3 border-white/10 border-dashed pt-4 text-xl",
                  i === openHours.length - 1 ? "row-span-4" : "row-span-6",
                ]}
              >
                {hour}
              </div>
            ))
          }
        </div>
      </div>
      <div
        id="schedule-blocks"
        class="pl-0.75 overflow-x-scroll overflow-y-visible xl:overflow-x-visible pb-1 relative"
      >
        <div class="w-315 xl:w-full grid grid-cols-7 gap-x-2">
          {
            scheduleConfig.map(({ blocks, day }) => (
              <ScheduleDay day={day} blocks={blocks} />
            ))
          }
        </div>
        <div
          class="absolute top-0 opacity-0 -z-1 w-315 xl:w-full group-has-[#schedule-hours-col:hover]:z-0 group-has-[#schedule-hours-col:hover]:opacity-100 transition-opacity"
          role="presentation"
        >
          <div class="h-11"></div>
          <div class="h-190 grid grid-rows-22 gap-2">
            {
              Array.from({ length: 4 }, (_, i) => (
                <div
                  class:list={[
                    "border-t-3 border-white/10 border-dashed",
                    i === openHours.length - 1 ? "row-span-4" : "row-span-6",
                  ]}
                />
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
  {/* Treasure hunt: swiping the schedule to its right/left end pops a sticker in from that side of the screen. */}
  <PopoutSticker id="ben-schedule" trigger="scroll-edge" edge="right" scrollTarget="#schedule-blocks" />
  <PopoutSticker id="david-schedule" trigger="scroll-edge" edge="left" scrollTarget="#schedule-blocks" />
</div>

<script>
  // To track scroll bar state for shadow effect on Schedule that should only show
  // when scroll bar appears + user scrolls to the right

  const debounce = (fn: Function) => {
    // This holds the requestAnimationFrame reference, so we can cancel it if we wish
    let frame: number;

    return (...params: any) => {
      // If the frame variable has been defined, clear it now, and queue for next frame
      if (frame) {
        cancelAnimationFrame(frame);
      }

      // Queue our function call for the next frame
      frame = requestAnimationFrame(() => {
        // Call our function and pass any params we received
        fn(...params);
      });
    };
  };

  // Reads out the scroll position and stores it in the data attribute so we can use it
  const storeScroll = () => {
    const el = document.getElementById("schedule-hours-col");
    if (el !== null) {
      el.dataset.scroll = document
        .getElementById("schedule-blocks")
        ?.scrollLeft.toString();
    }
  };

  document
    .getElementById("schedule-blocks")
    ?.addEventListener("scroll", debounce(storeScroll), { passive: true });

  storeScroll();
</script>
