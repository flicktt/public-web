      {
        type: "clubTable",
        isPeak: false,
        hours: 7,
      },
      {
        type: "clubTable",
        isPeak: true,
        hours: 2,
      },
      {
        type: "group",
        lvl: "3-4-5",
        hours: 2,
      },
    ],
  },
  {
    day: "Tue",
    blocks: [
      {
        type: "clubTable",
        isPeak: false,
        hours: 7,
      },
      {
        type: "clubTable",
        isPeak: true,
        hours: 2,
      },
      {
        type: "group",
        lvl: "2-3",
        hours: 2,
      },
    ],
  },
  {
    day: "Wed",
    blocks: [
      {
        type: "clubTable",
        isPeak: false,
        hours: 1,
      },
      {
        type: "group",
        lvl: "all",
        hours: 2,
      },
      {
        type: "clubTable",
        isPeak: false,
        hours: 4,
      },
      {
        type: "clubTable",
        isPeak: true,
        hours: 2,
      },
      {
        type: "group",
        lvl: "1-2",
        hours: 2,
      },
    ],
  },
  {
    day: "Thu",
    blocks: [
      {
        type: "clubTable",
        isPeak: false,
        hours: 7,
      },
      {
        type: "clubTable",
        isPeak: true,
        hours: 2,
      },
      {
        type: "group",
        lvl: "3-4",
        hours: 2,
      },
    ],
  },
  {
    day: "Fri",
    blocks: [
      {
        type: "clubTable",
        isPeak: false,
        hours: 7,
      },
      {
        type: "clubTable",
        isPeak: true,
        hours: 2,
      },
      {
        type: "clubLeague",
        matching: "any",
        hours: 2,
      },
    ],
  },
  {
    day: "Sat",
    blocks: [
      {
        type: "clubTable",
        isPeak: true,
        hasRobot: true,
        hours: 3,
      },
      {
        type: "group",
        lvl: "1-2",
        hours: 2,
      },
      {
        type: "group",
        lvl: "u18-1-2",
        hours: 1.5,
      },
      {
        type: "group",
        lvl: "u18-3-4",
        hours: 1.5,
      },
      {
        type: "clubTable",
        isPeak: true,
        hasRobot: true,
        hours: 1,
      },
      {
        type: "group",
        lvl: "3-4",
        hours: 2,
      },
    ],
  },
  {
    day: "Sun",
    blocks: [
      {
        type: "clubTable",
        isPeak: true,
        hours: 1,
      },
      {
        type: "clubLeague",
        matching: "any",
        hours: 2,
      },
      {
        type: "clubLeague",
        matching: "any",
        hours: 2,
      },
      {
        type: "clubTable",
        isPeak: true,
