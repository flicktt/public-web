---
import InfoHighlightLayout from "../../layouts/InfoHighlightLayout.astro";
import { getDateString } from "../../utils";

// u18: 25 oct, 17 jan, 14 mar, 23 may, 27 jun
const tournamentDates = [
  "2026-10-25",
  "2027-01-17",
  "2027-03-14",
  "2027-05-23",
  "2027-06-27",
];

const date = tournamentDates.find((tDate) => new Date(tDate) > new Date());
---
  
  <InfoHighlightLayout title="Next Tournament" size="md">
    {date ? (
      <div class="flex flex-col">
        <h4 class="font-bold text-2xl">{getDateString(new Date(date))}</h4>
        <p>9:30am - 1:30pm</p>
      </div>
      <p>48 players</p>
      <p>Group stage, then main & consolation draw</p>
      <p>
        <b>Fee:</b>{" "}
        £8 (Members) / £16 (Non-Members)
      </p>
      <p>
        <b>Prizes:</b>{" "}
        Winner: £125, Runner Up: £75, 3rd Place: £50, plus consolation prizes
      </p>
    ): (
      <p>Keep your eyes peeled in our social media for any upcoming tournaments!</p>
    )}
  </InfoHighlightLayout>