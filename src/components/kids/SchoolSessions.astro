---
import MainImage from "../../assets/offerings-corporate-main.jpg";
import OfferingsLayout from "../../layouts/OfferingsLayout.astro";
import Button from "../ui/inputs/Button.astro";

const desc =
  "Flick TT brings the game to schools or welcomes students to our premium venue. We currently collaborate with four schools, delivering fully customised sessions tailored to group size, skill level, and location. Coaches design each session to combine skill development, fun, and engagement, ensuring every student gets the right level of challenge and personalised attention.";
---

<OfferingsLayout
  title="School Sessions"
  img={{ src: MainImage.src, alt: "School session" }}
  desc={desc}
  linkBtn={{
    label: "Contact us",
    href: "mailto:flickservices@gmail.com",
    external: true,
  }}
/>
