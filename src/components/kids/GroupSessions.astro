---
import MainImage from "../../assets/offerings-group-sessions-main.jpg";
import OfferingsLayout from "../../layouts/OfferingsLayout.astro";

const desc =
  "Our level-based group sessions are structured to balance quality coaching, focused training, and match play. Each two-hour session includes a 15-minute warm-up, 45 minutes of drill practice, and 30 minutes of match play. Coaches provide personalised feedback to every player, with groups organised by level to ensure the right challenge and steady improvement.";
---

<OfferingsLayout
  title="Group Sessions"
  img={{ src: MainImage.src, alt: "Kids group session" }}
  desc={desc}
  linkBtn={{
    label: "Book now",
    href: "https://bookwhen.com/flicktt",
    external: true,
  }}
/>
