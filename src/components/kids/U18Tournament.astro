---
import MainImage from "../../assets/offerings-workshops-main.png";
import InfoHighlightLayout from "../../layouts/InfoHighlightLayout.astro";
import OfferingsLayout from "../../layouts/OfferingsLayout.astro";
import type { FaqConfig } from "../../types";
import Button from "../ui/inputs/Button.astro";

const desc =
  "Our U18 tournaments run every two months, with 48 young players per event competing in a points-based ranking system. The top 16 across the five-tournament series qualify for the final, with prizes including free club sessions. A structured, competitive, and exciting environment for junior players to develop and test their skills.";

const faqConfig: FaqConfig[] = [
  {
    title: "Who can enter?",
    Content: "Any player under 18 years old.",
  },
  {
    title: "How does the ranking series work?",
    Content:
      "Tournaments run every two months with a points-based ranking system. The top 16 players across the five-tournament series qualify for the final.",
  },
  {
    title: "What does it cost?",
    Content: "£8 for members and £16 for non-members.",
  },
];
---

<OfferingsLayout
  title="U18 Tournament"
  img={{ src: MainImage.src, alt: "Under 18s tournament" }}
  desc={desc}
  linkBtn={{
    label: "Register now",
    href: "https://bookwhen.com/flicktt-competitions",
    external: true,
  }}
  faqConfig={faqConfig}
>
  <InfoHighlightLayout title="Next Tournament" size="md">
    <div class="flex flex-row gap-1 items-end">
      <h5 class="font-bold text-2xl">21 June 2026</h5>
      <p>9:30am - 1:30pm</p>
    </div>
    <p>48 players</p>
    <p>Group stage, then main & consolation draw</p>
    <p>
      <span class="font-semibold">Fee:</span>{" "}
      £8 (Members) / £16 (Non-Members)
    </p>
    <p>
      <span class="font-semibold">Prizes:</span>{" "}
      Winner: £125, Runner Up: £75, 3rd Place: £50, plus consolation prizes
    </p>
  </InfoHighlightLayout>
</OfferingsLayout>
