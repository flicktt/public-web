---
import FooterLogo from "../../assets/logo-club.svg";
import IgLogo from "../../assets/ig-logo.svg";
import WhatsAppLogo from "../../assets/whatsapp-logo.svg";
import { CONTACT_CONSTS } from "../../constants";
---

<footer class="bg-[#111111] p-7.5 text-xl">
  <div class="grid grid-cols-1 gap-8 sm:gap-2.5 sm:grid-cols-2">
    <div class="order-2 self-end sm:max-w-75 sm:order-1">
      <a href="/">
        <FooterLogo />
      </a>
    </div>
    <div class="order-1 flex flex-col gap-6 text-right sm:order-2">
      <h2 class="text-3xl">
        <a href="/about#contact-us" target="_blank" class="hover:underline"
          >Contact</a
        >
      </h2>
      <address>
        <a
          href="https://maps.app.goo.gl/pxRgqkdwtRLoAZk79"
          target="_blank"
          class="hover:underline"
        >
          Decathlon Surrey Quays
          <br />
          9 Maritime Street
          <br />
          London<br />
          SE16 7FU
        </a>
      </address>
      <ul class="flex self-end gap-2">
        <li>
          <a
            class="flex self-end"
            href="https://www.instagram.com/flickttlondon/"
            target="_blank"
          >
            <IgLogo height={22} width={22} />
          </a>
        </li>
        <li>
          <a
            class="flex self-end"
            href={CONTACT_CONSTS.whatsapp}
            target="_blank"
          >
            <WhatsAppLogo height={22} width={22} />
          </a>
        </li>
      </ul>
      <a
        class="flex self-end hover:underline"
        href={`mailto:${CONTACT_CONSTS.supportEmail}`}
      >
        {CONTACT_CONSTS.supportEmail}
      </a>
      <ul class="flex flex-col gap-y-1 xl:flex-row xl:justify-between">
        <li>© 2026 by Flick TT Ltd.</li>
        <li>Website by Siddhartha</li>
        <li>
          <button class="cursor-pointer text-right" id="scroll-to-top">
            BACK TO TOP ↑
          </button>
        </li>
      </ul>
    </div>

    <script>
      const scrollToTopEl = document.getElementById("scroll-to-top");
      scrollToTopEl?.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    </script>
  </div>
</footer>
