---
import FooterLogo from "../../assets/logo-club.svg";
---

<footer class="bg-[#111111] p-7.5 text-xl">
  <div class="grid grid-cols-1 gap-8 sm:gap-2.5 sm:grid-cols-2">
    <div class="order-2 self-end sm:max-w-75 sm:order-1">
      <a href="/">
        <FooterLogo />
      </a>
    </div>
    <div class="order-1 flex flex-col gap-10 text-right sm:order-2">
      <h2 class="text-3xl">Contact</h2>
      <address>
        <a
          href="https://maps.app.goo.gl/pxRgqkdwtRLoAZk79"
          target="_blank"
          class="hover:underline"
        >
          Decathlon Surrey Quays
          <br />
          9 Maritime Street
          <br />
          London<br />
          SE16 7FU
        </a>
      </address>
      <ul>
        <li>
          <a
            class="w-auto hover:underline"
            href="mailto:flickservices@gmail.com"
          >
            flickservices@gmail.com
          </a>
        </li>
        <li>
          <a
            class="w-auto hover:underline"
            href="https://www.instagram.com/flickttlondon/"
            target="_blank"
          >
            Instagram
          </a>
        </li>
      </ul>
      <div class="flex flex-col xl:flex-row xl:justify-between">
        <p>© 2026 by Flick TT Ltd.</p>
        <p>Website by Siddhartha</p>
        <button
          class="cursor-pointer text-right hover:underline"
          id="scroll-to-top"
        >
          BACK TO TOP ↑
        </button>
      </div>
    </div>
  </div>
</footer>

<script>
  const scrollToTopEl = document.getElementById("scroll-to-top");
  scrollToTopEl?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });
</script>
