---
import { Image } from "astro:assets";
import footerLogo from "../../assets/logo-club.png";
import IgLogo from "../../assets/ig-logo.svg";
import WhatsAppLogo from "../../assets/whatsapp-logo.svg";
import { CONTACT_CONSTS } from "../../constants";
import Sticker from "../treasureHunt/Sticker.astro";

const year = new Date().getFullYear();
---

<!-- mt-auto pins the footer to the viewport bottom on short pages (e.g. the 404 page); <body> is a min-h-screen flex column. -->
<footer class="mt-auto bg-[#111111] p-7.5 text-xl">
  <div class="grid grid-cols-1 gap-8 sm:gap-2.5 sm:grid-cols-2">
    <div class="order-2 self-end sm:max-w-75 sm:order-1">
      <a href="/">
        <Image
          src={footerLogo}
          alt="Flick Table Tennis Club"
          width={600}
          widths={[300, 600]}
          sizes="300px"
          loading="lazy"
        />
      </a>
    </div>
    <div class="order-1 flex flex-col gap-6 text-right sm:order-2">
      <a
        href="/about/#contact-us"
        class="font-semibold text-3xl w-fit self-end hover:underline"
      >
        Contact
      </a>
      <address>
        <a
          href={CONTACT_CONSTS.gmap}
          target="_blank"
          rel="noopener"
          class="hover:underline"
        >
          Decathlon Surrey Quays
          <br />
          9 Maritime Street
          <br />
          London<br />
          SE16 7FU
        </a>
      </address>
      <ul class="flex self-end gap-2">
        <li>
          <a
            class="flex self-end"
            href="https://www.instagram.com/flickttlondon/"
            target="_blank"
            rel="noopener"
            aria-label="Instagram"
          >
            <IgLogo height={22} width={22} />
          </a>
        </li>
        <li>
          <a
            class="flex self-end"
            href={CONTACT_CONSTS.whatsapp}
            target="_blank"
            rel="noopener"
            aria-label="WhatsApp"
          >
            <WhatsAppLogo height={22} width={22} />
          </a>
        </li>
      </ul>
      <a
        class="flex self-end hover:underline"
        href={`mailto:${CONTACT_CONSTS.supportEmail}`}
      >
        {CONTACT_CONSTS.supportEmail}
      </a>
      <ul class="flex flex-col gap-y-1 xl:flex-row xl:justify-between">
        <li>© {year} by Flick TT Ltd.</li>
        <li>
          Website by{" "}
          {/* Treasure hunt: the sticker pops up above the name on hover, or on click/tap for touch and keyboard. */}
          <span class="group relative inline-block">
            <Sticker
              id="sid-footer"
              size={96}
              class="absolute left-1/2 bottom-full mb-1 -translate-x-1/2 pointer-events-none opacity-0 translate-y-2 transition-[opacity,translate] duration-300 group-hover:opacity-100 group-hover:translate-y-0 data-shown:opacity-100 data-shown:translate-y-0"
              data-sticker-reveal
            />
            <button type="button" id="sid-sticker-toggle" class="cursor-pointer">
              Sid Gurung
            </button>
          </span>
        </li>
        <li>
          <button class="cursor-pointer text-right" id="scroll-to-top">
            BACK TO TOP ↑
          </button>
        </li>
      </ul>
    </div>
  </div>
</footer>

<script>
  const sidToggle = document.getElementById("sid-sticker-toggle");
  const sidSticker = document.querySelector<HTMLElement>("[data-sticker-reveal]");
  sidToggle?.addEventListener("click", () => {
    sidSticker?.toggleAttribute("data-shown");
  });

  const scrollToTopEl = document.getElementById("scroll-to-top");
  scrollToTopEl?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });
</script>
