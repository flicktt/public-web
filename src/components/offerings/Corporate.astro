---
import MainImage from "../../assets/offerings-corporate-main.jpg";
import OfferingsLayout from "../../layouts/OfferingsLayout.astro";

const desc =
  "Looking to host a unique corporate event in London? From team-building and client entertainment to wellbeing days and family-friendly sessions, we design table tennis experiences to fit your goals, your people, and your schedule. Join us at our premium venue next to Canada Water station on the Jubilee Line, or let us bring the event directly to your workplace.";
---

<OfferingsLayout
  title="Corporate"
  img={{ src: MainImage.src, alt: "Corporate" }}
  desc={desc}
  linkBtn={{
    label: "Contact us",
    href: "mailto:services@flicktt.club",
    external: true,
  }}
/>
