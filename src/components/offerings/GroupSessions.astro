---
import MainImage from "../../assets/offerings-group-sessions-main.jpg";
import InfoHighlightLayout from "../../layouts/InfoHighlightLayout.astro";
import OfferingsLayout from "../../layouts/OfferingsLayout.astro";
import type { FaqConfig } from "../../types";
import Accordion from "../accordion/Accordion.astro";
import AccordionContent from "../accordion/AccordionContent.astro";
import AccordionStack from "../accordion/AccordionStack.astro";
import AccordionTitle from "../accordion/AccordionTitle.astro";

const desc =
  "Our level-based group sessions are structured to balance quality coaching, focused training, and match play. Each two-hour session includes a 15-minute warm-up, 1 hour 15 minutes of drill practice, and 30 minutes of match play. Coaches provide personalised feedback to every player, with groups organised by level to ensure the right challenge and steady improvement.";

const faqConfig: FaqConfig[] = [
  {
    title:
      "I'm nervous about joining a group session. Can I try a session first?",
    Content:
      "Absolutely! We are happy to offer a free trial session for those who are unsure. Just send us a message and we'd be happy to arrange for you to try one of our sessions!",
  },
  {
    title:
      "I'm not a complete beginner but I'm not sure what level I'm playing at. Which level should I book?",
    Content:
      "If you are unsure about your level, please get in touch and our coaches will arrange a session with you to assess your level!",
  },
  {
    title: "Do I need to bring my own racket?",
    Content:
      "No. We have rackets at the club you can borrow for the session, though most regulars bring their own. We do highly recommend that you have your own racket since it significantly improves your consistency in training. If you need help buying a racket, please get in touch and our coaches will be more than happy to help you with it!",
  },
  {
    title: "What should I wear?",
    Content:
      "Comfortable clothes and non-marking indoor trainers. Please note that any shoes that are not non-marking trainers will not be allowed, as they can damage our flooring.",
  },
  {
    title: "How long is a session and what does it involve?",
    Content:
      "Each session is two hours. It involves a 15-minute warm-up, 75 minutes of drill practice, and 30 minutes of match play. Our coaches give continuous feedback throughout the session.",
  },
  {
    title: "How much does it cost?",
    Content: "Group sessions are £20, or £12 for club members.",
  },
  {
    title: "Do I have to commit to a block of sessions?",
    Content:
      "Not at all! Our sessions are all booked individually, so you can come as often or as little as you like.",
  },
];
---

<OfferingsLayout
  title="Group Sessions"
  img={{ src: MainImage.src, alt: "Group session" }}
  desc={desc}
  linkBtn={{
    label: "Book now",
    href: "https://bookwhen.com/flicktt",
    external: true,
  }}
  faqConfig={faqConfig}
>
  <InfoHighlightLayout
    title="Group Coaching Levels (1-4)"
    containerProps={{ class: "gap-6" }}
  >
    <p class="text-xl md:text-2xl">
      <b>
        Our group sessions are split by levels so you train at the right pace
        and improve faster. Levels are based on repeatable skills, not “who wins
        games”.
      </b>
    </p>
    <p>
      Not sure where you fit? Book a Level 1-2 session or ask a coach on the day
      — we'll guide you to the best group for progress.
    </p>

    <AccordionStack>
      <Accordion>
        <AccordionTitle
          id="offerings-grp-sess-lvl-1-btn"
          ariaControls="offerings-grp-sess-lvl-1-panel"
        >
          LEVEL 1 — Solid foundations (stance, grip, control)
        </AccordionTitle>
        <AccordionContent
          id="offerings-grp-sess-lvl-1-panel"
          ariaLabelledBy="offerings-grp-sess-lvl-1-btn"
        >
          <div class="flex flex-col gap-3">
            <p>
              <b>Perfect if:</b> you're new, returning after a break, or you can rally
              “sometimes” but don't feel in control.
            </p>

            <div>
              <b>We focus on</b>
              <ul class="list-disc list-inside">
                <li>
                  Ready position (stance), balance and distance to the table
                </li>
                <li>Correct grip and racket angle</li>
                <li>Clean contact and simple, consistent strokes (no spin)</li>
              </ul>
            </div>

            <div>
              <b>You will learn</b>
              <ul class="list-disc list-inside">
                <li>Forehand & backhand basics with a stable trajectory</li>
                <li>Simple placement (cross-court / down-the-line)</li>
                <li>
                  First consistency drills: keep the ball on the table with good
                  form
                </li>
              </ul>
            </div>

            <div>
              <b>To move up to Level 2</b>
              <ul class="list-disc list-inside">
                <li>
                  You can rally comfortably on both sides at a steady pace
                </li>
                <li>Your technique stays stable under light pressure</li>
                <li>
                  You understand and apply basic coaching corrections (distance,
                  angle, timing)
                </li>
              </ul>
            </div>

            <p>
              <b>Main difference vs Level 2:</b> Level 1 builds control. Level 2 adds
              real consistency with spin awareness.
            </p>
          </div>
        </AccordionContent>
      </Accordion>

      <Accordion>
        <AccordionTitle
          id="offerings-grp-sess-lvl-2-btn"
          ariaControls="offerings-grp-sess-lvl-2-panel"
        >
          LEVEL 2 — Consistency + understanding spin
        </AccordionTitle>
        <AccordionContent
          id="offerings-grp-sess-lvl-2-panel"
          ariaLabelledBy="offerings-grp-sess-lvl-2-btn"
        >
          <div class="flex flex-col gap-3">
            <p>
              <b>Perfect if:</b> you can rally, but spin (especially serves) makes
              the ball fly long, drop in the net, or kick sideways.
            </p>

            <div>
              <b>We focus on</b>
              <ul class="list-disc list-inside">
                <li>Stronger forehand/backhand consistency with placement</li>
                <li>Reading topspin / backspin / sidespin</li>
                <li>Basic receive so you stop giving away free points</li>
              </ul>
            </div>

            <div>
              <b>You will learn</b>
              <ul class="list-disc list-inside">
                <li>Controlled rallies with better depth and direction</li>
                <li>How to identify spin and adjust racket angle + timing</li>
                <li>Safer pushes and controlled returns against backspin</li>
              </ul>
            </div>

            <div>
              <b>To move up to Level 3</b>
              <ul class="list-disc list-inside">
                <li>
                  You can keep consistent rallies with intention (not just
                  “survive”)
                </li>
                <li>
                  You recognise common spins and react correctly most of the
                  time
                </li>
                <li>Your basics hold up in longer drills</li>
              </ul>
            </div>

            <p>
              <b>Main difference vs Level 3:</b> Level 2 is “I understand spin.” Level
              3 is “I can attack with topspin and defend with blocks.”
            </p>
          </div>
        </AccordionContent>
      </Accordion>

      <Accordion>
        <AccordionTitle
          id="offerings-grp-sess-lvl-3-btn"
          ariaControls="offerings-grp-sess-lvl-3-panel"
        >
          LEVEL 3 — Topspin consistency + blocking + structured drills
        </AccordionTitle>
        <AccordionContent
          id="offerings-grp-sess-lvl-3-panel"
          ariaLabelledBy="offerings-grp-sess-lvl-3-btn"
        >
          <div class="flex flex-col gap-3">
            <p>
              <b>Perfect if:</b> you want to play modern table tennis: open the point,
              pressure, and hold rallies without breaking down.
            </p>

            <div>
              <b>We focus on</b>
              <ul class="list-disc list-inside">
                <li>Reliable topspin (not occasional hero shots)</li>
                <li>Blocking technique (control + placement)</li>
                <li>
                  Structured multi-step drills (including 12-ball patterns)
                </li>
              </ul>
            </div>

            <div>
              <b>You will learn</b>
              <ul class="list-disc list-inside">
                <li>
                  Forehand topspin consistency (and backhand topspin progression
                  when appropriate)
                </li>
                <li>Opening vs backspin (the key “next step” skill)</li>
                <li>Active blocks: control height, depth and direction</li>
                <li>
                  Longer patterns: rhythm, placement changes, and transitions
                </li>
              </ul>
            </div>

            <div>
              <b>To move up to Level 4</b>
              <ul class="list-disc list-inside">
                <li>
                  You can topspin safely with margin and repeat it in drills
                </li>
                <li>You can block without popping the ball up</li>
                <li>
                  You complete longer patterns with stable technique and
                  decisions
                </li>
              </ul>
            </div>

            <p>
              <b>Main difference vs Level 4:</b> Level 3 builds your rally engine.
              Level 4 teaches you to win points from the serve + first 3 balls.
            </p>
          </div>
        </AccordionContent>
      </Accordion>

      <Accordion>
        <AccordionTitle
          id="offerings-grp-sess-lvl-4-btn"
          ariaControls="offerings-grp-sess-lvl-4-panel"
        >
          LEVEL 4 — Serve + receive + “first 3 balls” (play with a plan)
        </AccordionTitle>
        <AccordionContent
          id="offerings-grp-sess-lvl-4-panel"
          ariaLabelledBy="offerings-grp-sess-lvl-4-btn"
        >
          <div class="flex flex-col gap-3">
            <p>
              <b>Perfect if:</b> you have good strokes, but points slip away on serve/receive,
              or you don't know what to do on 3rd/5th ball.
            </p>

            <div>
              <b>We focus on</b>
              <ul class="list-disc list-inside">
                <li>Serve quality and variation with a purpose</li>
                <li>Receive that doesn't gift easy points</li>
                <li>
                  First 3 balls patterns: serve → receive → 3rd ball attack
                </li>
              </ul>
            </div>

            <div>
              <b>You will learn</b>
              <ul class="list-disc list-inside">
                <li>
                  Practical serve fundamentals (contact, control, disguise,
                  intention)
                </li>
                <li>
                  Useful variations: short/long, backspin/topspin/sidespin
                  mixes, float
                </li>
                <li>
                  Receive options (short/long push, controlled placement, basic
                  flick when suitable)
                </li>
                <li>
                  3rd ball attack with high percentage (repeatable, not risky)
                </li>
              </ul>
            </div>

            <div>
              <b>To move up to Level 5</b>
              <ul class="list-disc list-inside">
                <li>Your serves create predictable returns</li>
                <li>Your receive stays stable under pressure</li>
                <li>
                  Your 3rd ball attack is reliable and you can continue the
                  point with intent
                </li>
              </ul>
            </div>
          </div>
        </AccordionContent>
      </Accordion>
    </AccordionStack>

    <div>
      <p class="mb-2 text-xl lg:text-2xl">
        <b>QUICK SELF-CHECK (pick your starting level)</b>
      </p>
      <ul>
        <li>
          <b>Level 1:</b> stance/grip basics + consistent simple hits (no spin)
        </li>
        <li>
          <b>Level 2:</b> consistent basics + understand spin, especially on serve/receive
        </li>
        <li>
          <b>Level 3:</b> consistent topspin + blocking + longer structured drills
        </li>
        <li>
          <b>Level 4:</b> serve/receive + strong first 3 balls and opening attack
        </li>
      </ul>
    </div>
  </InfoHighlightLayout>
</OfferingsLayout>
