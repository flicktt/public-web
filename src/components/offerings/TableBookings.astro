---
import MainImage from "../../assets/offerings-table-bookings-main.jpg";
import OfferingsLayout from "../../layouts/OfferingsLayout.astro";
import Button from "../ui/inputs/Button.astro";

const desc =
  "Book a table and enjoy flexible, uninterrupted playing time at our premium venue. Perfect for practice matches, casual play, or training with friends, all on professional flooring in a high-quality setting.";
---

<OfferingsLayout
  title="Table Bookings"
  img={{ src: MainImage.src, alt: "Table bookings" }}
  desc={desc}
>
  <a href="https://bookwhen.com/flicktt-tables" target="_blank" class="m-auto">
    <Button class="mb-2" size="lg">Book now</Button>
  </a>
</OfferingsLayout>
