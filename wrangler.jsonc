{
	"compatibility_date": "2026-05-21",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "flick-tt-web",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},

	// Production — deployed from `master` (default environment).
	"routes": [
		{ "pattern": "www.flicktt.com/*", "zone_name": "flicktt.com" }
	],
	"vars": { "SITE_ENV": "production" },

	// Environments do not inherit `routes`/`vars`; each declares its own.
	"env": {
		// Preview — deployed from `dev`; selected at build time with CLOUDFLARE_ENV=preview
		// (the Astro adapter flattens the config), producing worker `flick-tt-web-preview`.
		"preview": {
			"routes": [
				{ "pattern": "preview.flicktt.club/*", "zone_name": "flicktt.club" }
			],
			"vars": { "SITE_ENV": "preview" }
		}
	}
}
